<!-- 插件列表图标：平台约定路径 META-INF/pluginIcon.svg（+ pluginIcon_dark.svg），
     <idea-plugin> 无 icon 属性，放 /icons/ 下不生效；ToolWindow 图标走 ZCodeIcons.ZcGui -->
<idea-plugin>
    <id>com.zcode.ideaplugin.zcode-assistant</id>
    <name>ZC GUI (AI Chat for ZCode)</name>
    <vendor email="csuftt@users.noreply.github.com" url="https://github.com/csuftt/zcode-jetbrains-plugin">ZC GUI</vendor>

    <description><![CDATA[
        <h3>ZC GUI</h3>
        <p><b>Manage ZCode sessions right inside the IDE</b> — list sessions, browse history, chat, and stream responses, powered by the ZCode Protocol (app-server) with an independently testable protocol client.</p>
        <ul>
            <li>Session list &amp; history browsing</li>
            <li>Chat with streaming output</li>
            <li>Embedded JCEF browser (browser-use host)</li>
            <li>Multi-workspace: mount other project directories, group sessions by directory chips, send files / selection across workspaces</li>
            <li>Send file / selection to input from context menu</li>
            <li>Model management with provider enable/disable</li>
        </ul>
        <h3>ZC GUI（中文）</h3>
        <p>在 IDEA 里管理 ZCode 会话：列表、查看历史、对话、流式输出，支持多工作区（挂载其他项目目录、会话按目录分组、跨工作区发送文件），基于 ZCode Protocol（app-server）实现，协议客户端独立可测。</p>
    ]]></description>

    <!-- 兼容的 IDE 版本范围：2023.3+ 全支持（含 2026.x EAP/正式版） -->
    <idea-version since-build="233" until-build="263.*"/>

    <!-- 依赖 JCEF（嵌入式 Chromium，用于渲染 React UI）。
         2026.2 起 JCEF API 从平台核心剥离为独立捆绑插件 com.intellij.modules.jcef，
         不显式声明依赖会触发 NoClassDefFoundError: JBCefJSQuery$Response。
         声明为可选依赖：2026.2+ 上要求该插件存在（缺失则不安装）；
         2026.1 及以下该插件 ID 不存在（JCEF 仍在平台核心），可选配置被忽略不影响加载。 -->
    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="jcef-dependency.xml">com.intellij.modules.jcef</depends>
    <!-- AI Commit Message（提交框 AI 生成按钮）：git4idea 出真 diff（各家 IDE 均内置捆绑；
         缺失时仅提交框按钮缺席，其余功能不受影响）。Action 注册在可选配置文件，
         无 git4idea 的 IDE 不加载该类（类体内引用 git4idea，不随主配置强载） -->
    <depends optional="true" config-file="git4idea-dependency.xml">Git4Idea</depends>

    <!-- 原生 UI 文案 bundle（messages/ZCodeBundle*.properties，默认中文 + en/ja/ko） -->
    <resource-bundle>messages.ZCodeBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <!-- 注册 ToolWindow（右侧工具栏）；canCloseContents 开启多标签关闭按钮（cc-gui 同款） -->
        <toolWindow id="ZCode"
                    anchor="right"
                    factoryClass="com.zcode.ideaplugin.ui.ZCodeToolWindowFactory"
                    icon="com.zcode.ideaplugin.ZCodeIcons.ZcGui"
                    secondary="false"
                    canCloseContents="true"/>
        <!-- 编辑器右键动作的气泡通知（复制AI引用结果反馈） -->
        <notificationGroup id="ZCode" displayType="BALLOON"/>
        <!-- 项目启动即预热自动归档调度器（缺陷BH：懒加载导致重启后不碰归档 tab 就静默不跑） -->
        <postStartupActivity implementation="com.zcode.ideaplugin.ZCodeProjectActivity"/>
        <!-- 状态栏 Widget（监督面入口前移：运行态 + 点击聚焦 + 双击新会话，调研 ③） -->
        <statusBarWidgetFactory id="ZCode.StatusBarWidget"
                                implementation="com.zcode.ideaplugin.ui.statusbar.ZCodeStatusBarWidgetFactory"/>
    </extensions>

    <actions>
        <!-- 右键发送文件/选中代码到输入框（对齐 cc-gui SendFilePathToInputAction / SendSelectionToTerminalAction）
             text/description 不走 XML %key%（2026.1 实测解析为占位符原文），由 action 类构造器
             经 ZCodeBundle.message 取值（cc-gui 同款做法）。
             SendSelectionToInput 须声明在 SendFileToInput 之前（后者的 EditorPopupMenu
             挂点按 relative-to-action 引用它，避免前向引用） -->
        <action id="ZCode.SendSelectionToInput"
                class="com.zcode.ideaplugin.action.SendSelectionToInputAction"
                icon="com.zcode.ideaplugin.ZCodeIcons.ZcGui">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt K"/>
        </action>
        <action id="ZCode.SendFileToInput"
                class="com.zcode.ideaplugin.action.SendFileToInputAction"
                icon="com.zcode.ideaplugin.ZCodeIcons.ZcGui">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="first"/>
            <add-to-group group-id="EditorTabPopupMenu" anchor="first"/>
            <!-- 编辑器右键发整文件（issue #15 用户诉求：打开的页面右键也想要） -->
            <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="ZCode.SendSelectionToInput"/>
        </action>
        <!-- 多工作区收口组（与 SendFileToInput 互斥显示，单一入口）：可投递目标>1 时
             以同名子菜单取代平铺项，子项按目录名区分、当前标签置顶标「（当前）」；
             文案在类构造器经 ZCodeBundle 取值（同上，不走 XML %key%） -->
        <group id="ZCode.SendToWorkspaceGroup"
               popup="true"
               class="com.zcode.ideaplugin.action.SendFileToWorkspaceGroupAction"
               icon="com.zcode.ideaplugin.ZCodeIcons.ZcGui">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="first"/>
            <add-to-group group-id="EditorTabPopupMenu" anchor="first"/>
            <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="ZCode.SendFileToInput"/>
        </group>
        <!-- 控制台右键：选中日志文本发送到输入框（发纯文本正文，行号引用是编辑器场景专属） -->
        <action id="ZCode.SendConsoleTextToInput"
                class="com.zcode.ideaplugin.action.SendConsoleTextToInputAction"
                icon="com.zcode.ideaplugin.ZCodeIcons.ZcGui">
            <add-to-group group-id="ConsoleEditorPopupMenu" anchor="first"/>
        </action>
        <!-- 控制台右键「发送最近错误」（无选区版，调研 ④）：锚点提取最近错误段送输入框诊断 -->
        <action id="ZCode.SendRecentErrorToInput"
                class="com.zcode.ideaplugin.action.SendRecentErrorToInputAction"
                icon="com.zcode.ideaplugin.ZCodeIcons.ZcGui">
            <add-to-group group-id="ConsoleEditorPopupMenu" anchor="after" relative-to-action="ZCode.SendConsoleTextToInput"/>
        </action>
        <!-- 测试树右键「让 ZC GUI 解释此次失败」（调研 ④ 加分项）：
             TestTreePopupMenu 是 SM 树共用组（2023.3 常量池探针实证），testProxy 按名取 -->
        <action id="ZCode.ExplainTestFailure"
                class="com.zcode.ideaplugin.action.ExplainTestFailureAction"
                icon="com.zcode.ideaplugin.ZCodeIcons.ZcGui">
            <add-to-group group-id="TestTreePopupMenu" anchor="last"/>
        </action>
        <!-- diff 视图右键「就选中改动问 ZC GUI」（验收对话桥，调研 ⑯）：
             必须挂 Diff.EditorPopupMenu——diff 编辑器右键非标准 EditorPopupMenu
             （TextDiffViewerUtil 后装 handler 先赢，标准组不可达，2023.3 反汇编实证） -->
        <action id="ZCode.DiffSelectionToInput"
                class="com.zcode.ideaplugin.action.DiffSelectionToInputAction"
                icon="com.zcode.ideaplugin.ZCodeIcons.ZcGui">
            <add-to-group group-id="Diff.EditorPopupMenu" anchor="last"/>
        </action>
        <!-- 右键复制选中代码的路径+行号引用到剪贴板（对齐 cc-gui CopySelectionReferenceAction） -->
        <action id="ZCode.CopySelectionReference"
                class="com.zcode.ideaplugin.action.CopySelectionReferenceAction"
                icon="com.zcode.ideaplugin.ZCodeIcons.ZcGui">
            <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="ZCode.SendFileToInput"/>
        </action>
    </actions>
</idea-plugin>
